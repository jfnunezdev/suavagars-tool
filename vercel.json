{
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/admin",
      "destination": "/admin/",
      "permanent": false
    },
    {
      "source": "/ferramenta",
      "destination": "/admin/",
      "permanent": false
    },
    {
      "source": "/ferramenta.html",
      "destination": "/admin/",
      "permanent": false
    },
    {
      "source": "/gestor",
      "destination": "/admin/",
      "permanent": false
    },
    {
      "source": "/gestor.html",
      "destination": "/admin/",
      "permanent": false
    },
    {
      "source": "/vagas",
      "destination": "/vagas.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/manifest.json",
      "destination": "/public/manifest.json"
    },
    {
      "source": "/sw.js",
      "destination": "/public/sw.js"
    },
    {
      "source": "/icon-192.png",
      "destination": "/public/icon-192.png"
    },
    {
      "source": "/icon-512.png",
      "destination": "/public/icon-512.png"
    },
    {
      "source": "/icone-app.png",
      "destination": "/public/icone-app.png"
    }
  ],
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        }
      ]
    }
  ]
}
