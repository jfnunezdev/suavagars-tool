{
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/ferramenta",
      "destination": "/ferramenta.html",
      "permanent": false
    },
    {
      "source": "/vagas",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/vagas.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/gestor",
      "destination": "/gestor.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/manifest.json",
      "destination": "/public/manifest.json"
    },
    {
      "source": "/sw.js",
      "destination": "/public/sw.js"
    },
    {
      "source": "/icon-192.png",
      "destination": "/public/icon-192.png"
    },
    {
      "source": "/icon-512.png",
      "destination": "/public/icon-512.png"
    }
  ]
}
